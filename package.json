{
  "name": "sequelize-ui",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "lint": "eslint --cache .",
    "format": "prettier --write src/**/*.{ts,tsx} e2e/**/*.ts",
    "check:format": "prettier --check src/**/*.{ts,tsx} e2e/**/*.ts",
    "check:types": "tsc -b tsconfig.check.json",
    "generate:css-types": "tailwindcss-classnames -i tailwind.config.js -o src/ui/styles/classnames/__generated__/tailwindcss-classnames.ts",
    "generate:jtd-schema:schema": "jtd-codegen src/api/schema/implementations/localStorage/v1/schema.jtd.json --typescript-out src/api/schema/implementations/localStorage/v1 --root-name schema-v1",
    "generate:jtd-schema:user-preferences": "jtd-codegen src/api/userPreferences/implementations/localStorage/v1/schema.jtd.json --typescript-out src/api/userPreferences/implementations/localStorage/v1 --root-name userPreferences-v1",
    "postbuild": "npm run sitemap",
    "sitemap": "next-sitemap",
    "test": "jest",
    "test:coverage": "npm test -- src e2e --coverage",
    "test:unit": "npm test -- src",
    "test:e2e": "jest e2e",
    "test:e2e:migrations": "jest e2e/migrations",
    "test:e2e:migrations:all": "cross-env SQL_DIALECT=all npm run test:e2e:migrations",
    "test:watch": "npm test -- --watch --"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "body-scroll-lock": "^4.0.0-beta.0",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "dompurify": "^3.3.1",
    "fast-deep-equal": "^3.1.3",
    "file-saver": "^2.0.5",
    "focus-trap": "^8.0.0",
    "jszip": "^3.10.1",
    "jtd": "^0.1.1",
    "marked": "^17.0.2",
    "nanoid": "^5.1.6",
    "next": "^16.1.6",
    "pluralize": "^8.0.0",
    "prism-react-renderer": "^2.4.1",
    "qs": "^6.15.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "scroll-into-view-if-needed": "^3.1.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-children": "^2.1.0",
    "tailwindcss-classnames": "~3.2.0",
    "tar": "^7.5.9"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@next/eslint-plugin-next": "^16.1.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/file-saver": "^2.0.7",
    "@types/jest-specific-snapshot": "^0.5.10",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/pluralize": "0.0.33",
    "@types/qs": "^6.14.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "autoprefixer": "^10.4.24",
    "check-os": "^1.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-localstorage-mock": "^2.4.26",
    "jest-specific-snapshot": "^8.0.0",
    "mysql2": "^3.17.2",
    "next-sitemap": "^4.2.3",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.2.4",
    "source-map-support": "^0.5.21",
    "sqlite3": "^5.0.2",
    "tedious": "^19.2.1",
    "typescript": "^5.9.3"
  }
}
